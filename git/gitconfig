# Shared defaults, linked to ~/.config/git/config.
# Identity, signing key and machine-specific settings live in the untracked
# ~/.gitconfig, which git reads after this file and `git config --global` writes to.

[alias]
    co = checkout
    sw = switch
    st = status
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
    l = log --pretty=oneline -n 20 --graph --abbrev-commit
    s = status -s
    d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"
    di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"
    p = pull --recurse-submodules
    c = clone --recursive
    ca = !git add -A && git commit -av
    go = "!f() { git switch -c \"$1\" 2> /dev/null || git switch \"$1\"; }; f"
    tags = tag -l
    branches = branch --all
    remotes = remote --verbose
    aliases = config --get-regexp alias
    amend = commit --amend --reuse-message=HEAD
    credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"
    reb = "!r() { git rebase -i HEAD~$1; }; r"
    retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"
    fb = "!f() { git branch -a --contains $1; }; f"
    ft = "!f() { git describe --always --contains $1; }; f"
    fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"
    fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"
    dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
    contributors = shortlog --summary --numbered
    whoami = "!git config user.email && git config user.name && git config user.signingkey"
    latest-tag = "!git rev-list --tags --max-count=1 | git describe"

[core]
    whitespace = space-before-tab,-indent-with-non-tab,trailing-space
    trustctime = false
    untrackedCache = true
    fsmonitor = true
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgSign = true

[init]
    defaultBranch = main

[commit]
    gpgSign = true
    verbose = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = copies

[merge]
    conflictStyle = zdiff3
    log = true

[rerere]
    enabled = true
    autoUpdate = true

[apply]
    whitespace = fix

[fetch]
    prune = true
    pruneTags = true
    all = true

[pull]
    rebase = true

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[mergetool]
    keepBackup = false

[difftool]
    prompt = false

[help]
    autocorrect = prompt
