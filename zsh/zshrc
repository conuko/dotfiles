export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

source "$DOTFILES_DIR/zsh/exports.zsh"
source "$DOTFILES_DIR/zsh/path.zsh"
source "$DOTFILES_DIR/zsh/options.zsh"
source "$DOTFILES_DIR/zsh/completion.zsh"
source "$DOTFILES_DIR/zsh/tools.zsh"
source "$DOTFILES_DIR/zsh/aliases.zsh"

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Syntax highlighting wraps every widget defined before it, so plugins load last.
source "$DOTFILES_DIR/zsh/plugins.zsh"
