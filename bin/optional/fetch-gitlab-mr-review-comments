#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any
from urllib.parse import quote, unquote, urlparse


EM_DASH = "\u2014"
MIDDLE_DOT = "\u00b7"
REPLY_MARK = "\u21b3"


def parse_merge_request_url(value: str) -> tuple[str, str]:
    parsed = urlparse(value.strip())
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError(
            "pass a full GitLab merge request URL, for example "
            "https://gitlab.example.com/group/project/-/merge_requests/42"
        )

    parts = [unquote(part) for part in parsed.path.split("/") if part]
    try:
        separator_index = parts.index("-")
    except ValueError as exc:
        raise ValueError("merge request URL must contain /-/merge_requests/<iid>") from exc

    project_parts = parts[:separator_index]
    tail = parts[separator_index + 1 :]
    if len(tail) < 2 or tail[0] != "merge_requests":
        raise ValueError("merge request URL must contain /-/merge_requests/<iid>")

    iid = tail[1]
    if not project_parts or not iid.isdigit():
        raise ValueError("merge request URL must include a project path and numeric iid")

    return "/".join(project_parts), iid


def fetch_discussions(project_path: str, iid: str) -> list[dict[str, Any]]:
    if shutil.which("glab") is None:
        raise RuntimeError("glab is not available on PATH")

    encoded_project_path = quote(project_path, safe="")
    endpoint = (
        f"projects/{encoded_project_path}/merge_requests/{iid}/discussions?per_page=100"
    )
    result = subprocess.run(
        ["glab", "api", endpoint],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"glab api failed: {message}")

    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("glab api did not return valid JSON") from exc

    if not isinstance(data, list):
        raise RuntimeError("glab api returned an unexpected response shape")

    return data


def unresolved_threads(discussions: list[dict[str, Any]]) -> list[dict[str, Any]]:
    threads: list[dict[str, Any]] = []
    for discussion in discussions:
        notes = discussion.get("notes") or []
        if not notes:
            continue

        first_note = notes[0]
        if first_note.get("system"):
            continue
        if first_note.get("resolvable") and first_note.get("resolved"):
            continue

        position = first_note.get("position") or {}
        path = position.get("new_path") or position.get("old_path")
        line = position.get("new_line") or position.get("old_line")
        replies = [
            {
                "author": (note.get("author") or {}).get("username", "unknown"),
                "body": note.get("body") or "",
            }
            for note in notes[1:]
            if not note.get("system")
        ]
        threads.append(
            {
                "thread_id": discussion.get("id", ""),
                "author": (first_note.get("author") or {}).get("username", "unknown"),
                "body": first_note.get("body") or "",
                "path": path,
                "line": line,
                "replies": replies,
            }
        )

    return sorted(threads, key=thread_sort_key)


def thread_sort_key(thread: dict[str, Any]) -> tuple[str, int]:
    return (thread.get("path") or "~~~", numeric_line(thread.get("line")))


def numeric_line(line: Any) -> int:
    try:
        return int(line)
    except (TypeError, ValueError):
        return 0


def render_markdown(threads: list[dict[str, Any]]) -> str:
    if not threads:
        return "_No unresolved review comments._\n"

    lines: list[str] = []
    current_section: str | None | object = object()
    for index, thread in enumerate(threads, start=1):
        section = thread.get("path")
        if section != current_section:
            if lines:
                lines.append("")
            lines.append("### General" if section is None else f"### `{section}`")
            lines.append("")
            current_section = section

        lines.extend(render_thread(index, thread))

    return "\n".join(lines).rstrip() + "\n"


def render_thread(index: int, thread: dict[str, Any]) -> list[str]:
    author = thread["author"]
    thread_id = thread["thread_id"]
    path = thread.get("path")
    line = thread.get("line")
    if path is None:
        first_line = f"{index}. **@{author}** {EM_DASH} @{author} {MIDDLE_DOT} `{thread_id}`"
    else:
        label = f"L{line}" if line is not None else "L?"
        target = f"{path}:{line}" if line is not None else path
        first_line = (
            f"{index}. **[{label}]({target})** {EM_DASH} @{author} "
            f"{MIDDLE_DOT} `{thread_id}`"
        )

    lines = [first_line]
    lines.extend(blockquote_lines(thread.get("body") or ""))
    for reply in thread.get("replies", []):
        lines.extend(reply_lines(reply))
    return lines


def blockquote_lines(body: str) -> list[str]:
    body_lines = body.splitlines() or [""]
    return [f"   > {line}" for line in body_lines]


def reply_lines(reply: dict[str, str]) -> list[str]:
    body_lines = (reply.get("body") or "").splitlines() or [""]
    author = reply.get("author") or "unknown"
    lines = [f"   - {REPLY_MARK} @{author}: > {body_lines[0]}"]
    lines.extend(f"     > {line}" for line in body_lines[1:])
    return lines


def default_output_path(project_path: str, iid: str) -> Path:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", project_path).strip("-") or "project"
    return Path.cwd() / f"gitlab-mr-review-comments-{slug}-mr-{iid}.md"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Fetch unresolved GitLab MR review comments into a markdown file."
    )
    parser.add_argument("merge_request_url", help="full GitLab merge request URL")
    parser.add_argument(
        "-o",
        "--output",
        help="output markdown file path; defaults to the current directory",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        project_path, iid = parse_merge_request_url(args.merge_request_url)
        output_path = (
            Path(args.output).expanduser()
            if args.output
            else default_output_path(project_path, iid)
        )
        if not output_path.is_absolute():
            output_path = Path.cwd() / output_path

        discussions = fetch_discussions(project_path, iid)
        markdown = render_markdown(unresolved_threads(discussions))
        output_path.write_text(markdown, encoding="utf-8")
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    print(f"Wrote {output_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
