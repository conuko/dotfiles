#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

install_brewfile_if_present() {
  local brewfile="$1"

  if [[ -f "$brewfile" ]]; then
    brew bundle install --file="$brewfile"
  fi
}

if git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
  git -C "$ROOT" pull --ff-only
else
  echo "No origin remote configured; skipping git pull."
fi

if command -v brew >/dev/null 2>&1; then
  brew update
  brew upgrade
  install_brewfile_if_present "$ROOT/Brewfile"
  install_brewfile_if_present "$ROOT/Brewfile.local"
fi

"$ROOT/bin/link"

if command -v mise >/dev/null 2>&1; then
  mise upgrade
fi

if command -v gh >/dev/null 2>&1; then
  gh extension upgrade --all || true
fi

if command -v brew >/dev/null 2>&1; then
  brew cleanup

  echo "Installed but not listed in a Brewfile (add them or uninstall them):"
  cat "$ROOT/Brewfile" "$ROOT"/Brewfile.local 2>/dev/null |
    brew bundle cleanup --file=- 2>/dev/null |
    awk '/^Would remove|^Run `brew/ { exit } { print }' || true
fi

echo "Update complete."
