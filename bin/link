#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="$HOME/.dotfiles-backups/$TIMESTAMP"

backup_target() {
  local target="$1"
  local backup_path="$BACKUP_DIR/${target#"$HOME"/}"

  mkdir -p "$(dirname "$backup_path")"
  mv "$target" "$backup_path"
  echo "Backed up $target -> $backup_path"
}

link_file() {
  local source="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]]; then
    if [[ "$(readlink "$target")" == "$source" ]]; then
      echo "Unchanged: $target"
      return 0
    fi

    backup_target "$target"
  elif [[ -e "$target" ]]; then
    backup_target "$target"
  fi

  ln -sfn "$source" "$target"
  echo "Linked: $target -> $source"
}

# Earlier versions linked ~/.gitconfig and ~/.gitignore into the repo, which made
# `git config --global` write into tracked files. ~/.gitconfig is now a local file.
migrate_legacy() {
  local legacy

  for legacy in "$HOME/.gitconfig" "$HOME/.gitignore"; do
    if [[ -L "$legacy" && "$(readlink "$legacy")" == "$ROOT/"* ]]; then
      backup_target "$legacy"
    fi
  done

  if [[ -f "$HOME/.gitconfig.local" && ! -e "$HOME/.gitconfig" ]]; then
    mv "$HOME/.gitconfig.local" "$HOME/.gitconfig"
    echo "Moved: ~/.gitconfig.local -> ~/.gitconfig"
  fi

  # Ghostty also reads this file, and it would override the linked config.
  local ghostty_legacy="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  if [[ -f "$ghostty_legacy" && ! -L "$ghostty_legacy" ]]; then
    backup_target "$ghostty_legacy"
  fi
}

migrate_legacy

link_file "$ROOT/zsh/zshrc" "$HOME/.zshrc"
link_file "$ROOT/zsh/zprofile" "$HOME/.zprofile"
link_file "$ROOT/git/gitconfig" "$CONFIG_HOME/git/config"
link_file "$ROOT/git/gitignore" "$CONFIG_HOME/git/ignore"
link_file "$ROOT/mise/config.toml" "$CONFIG_HOME/mise/config.toml"
link_file "$ROOT/starship/starship.toml" "$CONFIG_HOME/starship.toml"
link_file "$ROOT/ghostty/config.ghostty" "$CONFIG_HOME/ghostty/config.ghostty"

echo "Dotfile linking complete."
